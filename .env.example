# Конфигурация МАГ-ОДЕЖ магазина
# Заполните эти данные для работы Telegram бота и Email уведомлений

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

# Получите у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Получите у @userinfobot в Telegram (или из getUpdates)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================

# Ваш Gmail адрес
EMAIL_SENDER=your_email@gmail.com

# Пароль приложения Gmail (НЕ обычный пароль!)
# Получить: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password

# ============================================
# СЕРВЕР
# ============================================

# Хост для запуска (0.0.0.0 для всех интерфейсов)
FLASK_HOST=0.0.0.0

# Порт для запуска
FLASK_PORT=5000

# Режим отладки (True/False)
FLASK_DEBUG=True

# ============================================
# РЕЖИМ РАЗРАБОТКИ
# ============================================

DEVELOPMENT_MODE=True
